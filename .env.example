# DEVELOPMENT DEMO ONLY. Copy to .env, then run npm install && npm start.
PORT=3000
NODE_ENV=development
DEMO_MODE=true
ALLOW_LOCAL_MONGO=true
# Blank uses a randomly generated development-only session secret.
SESSION_SECRET=
# Leave blank for a real, locally managed development MongoDB process.
# Alternatively, use your own MongoDB / Atlas connection string.
MONGODB_URI=
# Used ONLY when DEMO_MODE=false and no admin exists yet.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Safety
BOOTSTRAP_ADMIN_LAST_NAME=Admin
